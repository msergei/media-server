FROM debian:stable-slim
ENV DEBIAN_FRONTEND=noninteractive
ENV USER=user
ENV PASS=pass

# Samba без recommends + чистка apt (слой до COPY конфигов — правки
# smb.sh/smb.conf не инвалидируют установку пакетов)
RUN apt-get update \
 && apt-get install -y --no-install-recommends samba samba-common-bin \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 smb.sh /run.sh
COPY smb.conf /etc/samba/smb.conf

EXPOSE 445
VOLUME ["/share"]

CMD ["bash", "/run.sh"]
