FROM debian:stable-slim
ARG UID=1000
ARG GID=200
ENV DEBIAN_FRONTEND=noninteractive

# Пользователь и группа
RUN groupadd -g $GID minidlna \
 && useradd -u $UID -g $GID -d /share -s /usr/sbin/nologin minidlna

# minidlna без recommends + чистка apt
RUN apt-get update \
 && apt-get install -y --no-install-recommends minidlna \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Директории (pid-файл живёт в tmpfs, см. docker-compose.yml)
RUN mkdir -p /share /var/cache/minidlna /var/log/minidlna \
 && chown minidlna:minidlna /share /var/cache/minidlna /var/log/minidlna

COPY minidlna.conf /etc/minidlna.conf
COPY --chmod=755 dlna-entrypoint.sh /usr/local/bin/dlna-entrypoint.sh

VOLUME ["/share","/var/cache/minidlna","/var/log/minidlna"]
EXPOSE 8200/tcp 1900/udp

USER minidlna
CMD ["/usr/local/bin/dlna-entrypoint.sh"]
